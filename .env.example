# This file is a placeholder for environment variables required to run this project.

# Password for protected pages/routes (legacy RouteGuard)
PAGE_ACCESS_PASSWORD=password

# NextAuth.js Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Google OAuth Provider
# Create credentials at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Admin Access Control
# Comma-separated list of email addresses allowed to access /admin
ADMIN_EMAILS=admin@example.com,another@example.com

# Database (PostgreSQL via Docker)
# Start PostgreSQL with: docker-compose up -d
DATABASE_URL="postgresql://portfolio_user:portfolio_password@localhost:5432/magic_portfolio?schema=public"

# S3-Compatible Storage Configuration
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO, Backblaze B2, etc.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=your-bucket-name
# Optional: Custom public URL for CDN or custom domain
S3_PUBLIC_URL=
# Set to "true" for MinIO, Cloudflare R2, or other path-style providers
S3_FORCE_PATH_STYLE=false
